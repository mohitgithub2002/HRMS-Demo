// Kosh HRMS Cloud — database schema.
//
// Two kinds of tables:
//  • Platform tables (Tenant, PlatformUser, PlatformSession, PlatformAudit, Session, OtpChallenge) — no row-level
//    security; only src/core and src/platform read them.
//  • Tenant tables — every one has `tenantId`, filled by default from the transaction setting app.tenant_id and
//    guarded by row-level security (migrations end with SELECT kosh_enable_rls()). See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform
// ─────────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CLOSED
}

/// An organisation served by this installation (a Cantonment Board, a municipal body, a company).
model Tenant {
  id               String       @id @default(cuid())
  /// Short code typed at sign-in ("DCB"). Upper case letters and digits, unique, never changes.
  code             String       @unique
  name             String
  nameHi           String?
  shortName        String?
  kind             String       @default("CANTONMENT_BOARD")
  status           TenantStatus @default(TRIAL)
  plan             String       @default("STANDARD")
  /// Enabled modules (see src/core/tenancy/modules.ts). Employees and settings are always on.
  modules          String[]
  maxUsers         Int          @default(500)
  maxEmployees     Int          @default(5000)
  /// Starter pack the masters were copied from, and its version.
  pack             String       @default("GOI_7CPC")
  packVersion      Int          @default(1)
  address          String?
  city             String?
  state            String?
  pincode          String?
  contactName      String?
  contactEmail     String?
  contactPhone     String?
  /// Brand colour for the organisation's sign-in page and header accent (hex).
  accentColor      String?
  logoFileId       String?
  trialEndsAt      DateTime?
  suspendedReason  String?
  setupCompletedAt DateTime?
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
}

enum PlatformRole {
  OWNER
  SUPPORT
}

model PlatformUser {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  role               PlatformRole @default(SUPPORT)
  passwordHash       String
  mustChangePassword Boolean      @default(true)
  isActive           Boolean      @default(true)
  failedLogins       Int          @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions PlatformSession[]
}

model PlatformSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  platformUserId String
  /// Set when the OTP step is passed; until then the session can only finish signing in.
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  ip             String?
  userAgent      String?

  user PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
}

/// What platform users did (create, suspend, change modules, reset an Admin). Append-only.
model PlatformAudit {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  action     String
  tenantId   String?
  summary    String
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

/// A signed-in organisation user. Bound to one tenant for its whole life.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  tenantId   String
  userId     String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([tenantId, userId])
}

enum OtpPurpose {
  LOGIN
  MOBILE_CHANGE
  SIGN
  PLATFORM_LOGIN
}

model OtpChallenge {
  id         String     @id @default(cuid())
  tenantId   String?
  userId     String?
  purpose    OtpPurpose
  codeHash   String
  sentTo     String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  lastSentAt DateTime   @default(now())
  createdAt  DateTime   @default(now())

  @@index([userId, createdAt])
}

/// A biometric device that pushes punches (eSSL / ZKTeco "ADMS"): its serial number says which organisation it
/// belongs to, because a push arrives without anyone signed in. Kept in step with Settings → Office hours.
model DeviceRegistration {
  serial    String   @id
  tenantId  String
  name      String?
  lastSeen  DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant — foundation
// ─────────────────────────────────────────────────────────────────────────────

/// The three logins (PRD §2).
enum LoginType {
  ADMIN
  HR_ACCOUNTS
  EMPLOYEE
}

/// Permissions an Admin can tick inside a login (PRD §2).
enum Permission {
  APPROVER
  PAY_BILL_SIGNER
  USER_SETTINGS_MANAGER
  HR
  PAYROLL
  PENSION
  CHECKER
  REPORTING_OFFICER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AttendanceMode {
  DEVICE
  MANUAL
}

/// A department / section of the organisation.
model Section {
  id             String         @id @default(cuid())
  tenantId       String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  code           String
  name           String
  nameHi         String?
  isActive       Boolean        @default(true)
  attendanceMode AttendanceMode @default(DEVICE)
  /// Weekly off days as "0,6" (0 = Sunday). Null follows the organisation's setting.
  weeklyOff      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employees Employee[]
  attendanceLocks AttendanceLock[]
  attendanceMonths AttendanceMonth[]

  @@unique([tenantId, code])
}

/// A post (designation). Retirement age follows the post (EM-02).
model Post {
  id            String   @id @default(cuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  code          String
  name          String
  nameHi        String?
  payLevel      String
  group         String
  retirementAge Int      @default(60)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees Employee[]

  @@unique([tenantId, code])
}

model User {
  id                 String       @id @default(cuid())
  tenantId           String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// What the person types at sign-in: an Employee ID or a username. Unique inside the organisation.
  loginId            String
  name               String
  loginType          LoginType
  permissions        Permission[]
  status             UserStatus   @default(ACTIVE)
  mobile             String?
  email              String?
  passwordHash       String?
  mustChangePassword Boolean      @default(true)
  failedLogins       Int          @default(0)
  lockedUntil        DateTime?
  locale             String       @default("en")
  /// The person's employee record, when the login belongs to an employee or pensioner.
  employeeId         String?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, loginId])
  @@index([tenantId, mobile])
  @@index([tenantId, employeeId])
}

enum AuditCategory {
  DATA
  SYSTEM
}

/// Every create / edit / approve / print (PRD §11). Append-only (trigger).
model AuditLog {
  id          String        @id @default(cuid())
  tenantId    String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  userId      String?
  userName    String?
  loginType   LoginType?
  ip          String?
  userAgent   String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  category    AuditCategory @default(DATA)
  isSensitive Boolean       @default(false)
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime      @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

/// Events for other systems (PRD §12 rule 5), written in the same transaction as the change.
model OutboxEvent {
  id          String    @id @default(cuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  type        String
  entityType  String
  entityId    String?
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([tenantId, processedAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

/// One decision waiting for someone (maker-checker). A chain (Checker, then Admin) is one task per step.
model ApprovalTask {
  id                 String         @id @default(cuid())
  tenantId           String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  kind               String
  title              String
  titleHi            String?
  /// Rows shown to the person deciding: [{ label, old, new }].
  details            Json?
  payload            Json
  status             ApprovalStatus @default(PENDING)
  requiredPermission Permission
  /// For a reporting officer's task: the section it belongs to.
  sectionId          String?
  /// The person the entry is about — nobody decides their own pay, loan or arrears (rule 2).
  subjectEmployeeId  String?
  entityType         String
  entityId           String?
  makerId            String
  makerName          String
  makerNote          String?
  deciderId          String?
  deciderName        String?
  decisionNote       String?
  decidedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([tenantId, status, requiredPermission])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, makerId])
}

/// Organisation settings, one row per key.
model Setting {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([tenantId, key])
}

/// Number series per organisation (Employee IDs, references).
model Sequence {
  id       String @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name     String
  value    Int    @default(0)

  @@unique([tenantId, name])
}

/// File contents (documents, generated PDFs and bank files) when STORAGE_DRIVER=database; otherwise metadata only.
model StoredFile {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name        String
  contentType String
  size        Int
  sha256      String
  driver      String
  data        Bytes?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum MessageChannel {
  SMS
  EMAIL
}

model MessageLog {
  id        String         @id @default(cuid())
  tenantId  String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  channel   MessageChannel
  to        String
  template  String
  status    String
  error     String?
  createdAt DateTime       @default(now())

  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 4 — Employee master (EM-01 … EM-10)
// ─────────────────────────────────────────────────────────────────────────────

enum EmployeeType {
  PERMANENT_OPS
  PERMANENT_NPS
  CONTRACT
  DAILY_WAGE
  REEMPLOYED
  DEPUTATION
}

enum EmployeeStatus {
  /// Entered by HR, waiting for the Checker; gets its Employee ID on approval.
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
  RESIGNED
  TRANSFERRED
  TERMINATED
  DECEASED
}

/// One record per person (EM-01). Every other module reads from it.
model Employee {
  id               String         @id @default(cuid())
  tenantId         String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  /// Null while the record is a draft; issued when it is approved.
  employeeCode     String?
  type             EmployeeType
  status           EmployeeStatus @default(ACTIVE)
  firstName        String
  middleName       String?
  lastName         String?
  nameHi           String?
  gender           String
  dateOfBirth      DateTime       @db.Date
  dateOfJoining    DateTime       @db.Date
  dateOfRetirement DateTime?      @db.Date
  /// Set when the person leaves for any reason; access ends on this date (§2 rule 6).
  exitDate         DateTime?      @db.Date
  exitReason       String?
  sectionId        String
  postId           String
  payLevel         String?
  payCell          Int?
  /// 1 (January) or 7 (July): the annual increment date. Empty = worked out from the date of joining.
  incrementMonth   Int?
  mobile           String?
  email            String?

  fatherOrSpouseName String?
  category           String?
  maritalStatus      String?
  bloodGroup         String?
  isDisabled         Boolean @default(false)
  /// { line1, line2, city, district, state, pincode }
  presentAddress     Json?
  permanentAddress   Json?

  // EM-03. Aadhaar, PAN and bank account are encrypted with the organisation's own key; *Hash finds duplicates.
  panEnc           String?
  panHash          String?
  panLast4         String?
  aadhaarEnc       String?
  aadhaarHash      String?
  aadhaarLast4     String?
  pran             String?
  uan              String?
  esicNumber       String?
  gpfNumber        String?
  bankAccountEnc   String?
  bankAccountHash  String?
  bankAccountLast4 String?
  ifsc             String?
  bankName         String?
  bankBranch       String?

  probationEndDate DateTime? @db.Date
  confirmationDate DateTime? @db.Date
  /// Enrolment number on the biometric devices (AT-01).
  biometricId      String?

  // Contract and daily-wage workers (RO-09)
  agencyName    String?
  wageRate      Decimal?  @db.Decimal(12, 2)
  wageBasis     String?
  contractStart DateTime? @db.Date
  contractEnd   DateTime? @db.Date

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     Section                @relation(fields: [sectionId], references: [id])
  post        Post                   @relation(fields: [postId], references: [id])
  users       User[]
  family      FamilyMember[]
  nominees    Nominee[]
  documents   EmployeeDocument[]
  serviceBook ServiceBookEntry[]
  history     EmployeeFieldHistory[]
  payHistory  PayHistory[]
  attendancePunchs AttendancePunch[]
  attendanceDays AttendanceDay[]
  attendanceRequests AttendanceRequest[]
  attendanceMonths AttendanceMonth[]
  leaveLedgers LeaveLedger[]
  leaveApplications LeaveApplication[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, biometricId])
  @@index([tenantId, sectionId])
  @@index([tenantId, status])
  @@index([tenantId, panHash])
  @@index([tenantId, aadhaarHash])
  @@index([tenantId, bankAccountHash])
}

model FamilyMember {
  id          String    @id @default(cuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId  String
  name        String
  nameHi      String?
  relation    String
  gender      String?
  dateOfBirth DateTime? @db.Date
  isDependent Boolean   @default(false)
  isDisabled  Boolean   @default(false)
  isAlive     Boolean   @default(true)
  createdAt   DateTime  @default(now())

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nominees Nominee[]

  @@index([tenantId, employeeId])
}

enum NomineeScheme {
  GPF
  GRATUITY
  GROUP_INSURANCE
  FAMILY_PENSION
  NPS
}

model Nominee {
  id             String        @id @default(cuid())
  tenantId       String        @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId     String
  scheme         NomineeScheme
  familyMemberId String
  sharePercent   Decimal       @db.Decimal(5, 2)
  createdAt      DateTime      @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, scheme])
}

model EmployeeDocument {
  id             String    @id @default(cuid())
  tenantId       String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId     String
  category       String
  title          String
  fileId         String
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  uploadedById   String
  uploadedByName String
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

enum ServiceEvent {
  APPOINTMENT
  CONFIRMATION
  INCREMENT
  PROMOTION
  MACP
  PAY_FIXATION
  TRANSFER
  LEAVE
  PENALTY
  REWARD
  RETIREMENT
  SUSPENSION
  REINSTATEMENT
  EXIT
  OTHER
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
}

/// e-Service book (EM-06).
model ServiceBookEntry {
  id           String       @id @default(cuid())
  tenantId     String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId   String
  event        ServiceEvent
  eventDate    DateTime     @db.Date
  orderNumber  String?
  orderDate    DateTime?    @db.Date
  details      String
  detailsHi    String?
  data         Json?
  documentId   String?
  status       EntryStatus  @default(PENDING)
  createdById  String
  approvedById String?
  createdAt    DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, eventDate])
}

/// Every changed value of a record: old → new, who made it, who approved it (EM-07).
model EmployeeFieldHistory {
  id           String   @id @default(cuid())
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId   String
  field        String
  /// Masked for Aadhaar, PAN and bank account.
  oldValue     String?
  newValue     String?
  isSensitive  Boolean  @default(false)
  changedById  String?
  changedBy    String?
  approvedById String?
  approvedBy   String?
  taskId       String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, createdAt])
}

/// Sanctioned strength per section and post (EM-09).
model SanctionedPost {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  sectionId   String
  postId      String
  sanctioned  Int
  orderRef    String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, sectionId, postId])
}

/// A pay matrix (7th CPC from 1 Jan 2016; a new commission is a new row with its own date — PR-01).
model PayMatrix {
  id            String   @id @default(cuid())
  tenantId      String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  name          String
  effectiveFrom DateTime @db.Date
  /// { "1": [18000, 18500, …], "2": [...], … } — Basic by level and cell.
  levels        Json
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, effectiveFrom])
}

enum PayChangeReason {
  INITIAL
  INCREMENT
  PROMOTION
  MACP
  CORRECTION
}

/// Level and cell from a date (increments, promotions, corrections).
model PayHistory {
  id             String          @id @default(cuid())
  tenantId       String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId     String
  effectiveFrom  DateTime        @db.Date
  payLevel       String
  payCell        Int
  postId         String?
  reason         PayChangeReason
  details        Json?
  serviceEntryId String?
  applied        Boolean         @default(false)
  createdById    String?
  createdAt      DateTime        @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([tenantId, reason, effectiveFrom])
}

enum HolidayKind {
  GAZETTED
  RESTRICTED
}

/// Holiday calendar (AT-08). Rows exist only for lists a Checker has approved.
model Holiday {
  id        String      @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  date      DateTime    @db.Date
  name      String
  nameHi    String
  kind      HolidayKind
  createdAt DateTime    @default(now())

  @@unique([tenantId, date, name])
  @@index([tenantId, date])
}

/// Daily status (AT-03). MISSED_PUNCH is provisional; DIES_NON is set only when the officer confirms (AT-05).
enum DayStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  MISSED_PUNCH
  ON_DUTY
  LEAVE
  HOLIDAY
  WEEKLY_OFF
  DIES_NON
}

enum DaySource {
  DEVICE
  MUSTER
  REQUEST
  LOCK
  LEAVE
}

/// One raw punch from a device push or an imported file. Duplicates are ignored by the unique key.
model AttendancePunch {
  id           String   @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId   String
  at           DateTime
  deviceSerial String?
  importId     String?
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, at])
  @@index([tenantId, at])
}

/// A punch file that was saved (AT-01): who, when, which format, checksum of the stored copy.
model AttendanceImport {
  id             String   @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  format         String
  fileName       String
  fileId         String
  sha256         String
  rowCount       Int
  savedCount     Int
  duplicateCount Int
  fromDate       DateTime @db.Date
  toDate         DateTime @db.Date
  createdById    String
  createdByName  String
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// The status of one person on one day. Days without a row are worked out from the calendar and punches.
model AttendanceDay {
  id            String    @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId    String
  date          DateTime  @db.Date
  status        DayStatus
  firstIn       DateTime?
  lastOut       DateTime?
  workedMinutes Int?
  source        DaySource
  /// Leave type when status is LEAVE (filled by the Leave module).
  leaveCode     String?
  /// Half of the day only (half-day leave or half-day dies-non).
  half          Boolean   @default(false)
  note          String?
  /// Manual muster entries and HR corrections wait for a Checker (AT-02).
  checked       Boolean   @default(true)
  /// The leave application that marked this day (LV-04), so cancelling it can undo the day.
  applicationId String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

enum AttendanceRequestType {
  MISSED_PUNCH
  ON_DUTY
}

/// Missed-punch or on-duty request by an employee (AT-04), decided by the reporting officer.
model AttendanceRequest {
  id          String                @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId  String
  date        DateTime              @db.Date
  type        AttendanceRequestType
  inTime      String?
  outTime     String?
  reason      String
  status      ApprovalStatus        @default(PENDING)
  taskId      String?
  createdById String
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, date])
}

/// A section's month, locked by its reporting officer or HR (AT-05). Payroll reads locked months only.
model AttendanceLock {
  id           String    @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  sectionId    String
  /// "YYYY-MM"
  month        String
  lockedById   String
  lockedByName String
  lockedAt     DateTime  @default(now())
  unlockedAt   DateTime?
  unlockNote   String?

  section Section @relation(fields: [sectionId], references: [id])

  @@unique([tenantId, sectionId, month])
}

/// Month totals per person, frozen at lock; what payroll reads (AT-05, AT-06).
model AttendanceMonth {
  id           String   @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId   String
  sectionId    String
  month        String
  daysInMonth  Int
  daysOnRoll   Int
  present      Decimal  @db.Decimal(5, 1)
  late         Int
  halfDays     Int
  onDuty       Int
  leave        Decimal  @db.Decimal(5, 1)
  holidays     Int
  weeklyOffs   Int
  diesNon      Decimal  @db.Decimal(5, 1)
  /// Leave on half pay (HPL) and on no pay (EOL) in the month — payroll applies the pay effect (LV-04).
  halfPayLeave Decimal  @default(0) @db.Decimal(5, 1)
  noPayLeave   Decimal  @default(0) @db.Decimal(5, 1)
  /// Days paid for regular staff: days on the rolls less dies-non (and no-pay leave once the Leave module runs).
  payableDays  Decimal  @db.Decimal(5, 1)
  /// Days actually worked — what contract and daily-wage workers are paid for (AT-06).
  workedDays   Decimal  @db.Decimal(5, 1)
  createdAt    DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([employeeId, month])
  @@index([tenantId, month])
}

enum LeavePay {
  FULL
  HALF
  NONE
}

/// HALF_YEARLY: credited on 1 Jan and 1 Jul (EL, HPL). YEARLY: on 1 Jan (CL, RH). SPELL: up to creditDays per
/// spell (maternity, paternity). SERVICE: creditDays in the whole service (CCL). NONE: no balance (EOL, commuted).
enum LeaveCreditMode {
  HALF_YEARLY
  YEARLY
  SPELL
  SERVICE
  NONE
}

/// The leave rules table (LV-01). HR proposes a change, an Admin approves it.
model LeaveType {
  id               String          @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  code             String
  name             String
  nameHi           String
  pay              LeavePay
  creditMode       LeaveCreditMode
  creditDays       Decimal         @default(0) @db.Decimal(6, 1)
  /// Highest balance allowed (EL 300).
  cap              Decimal?        @db.Decimal(6, 1)
  lapsesAtYearEnd  Boolean         @default(false)
  /// Commuted leave is taken from HPL at 2 days per day.
  debitFrom        String?
  debitFactor      Decimal         @default(1) @db.Decimal(3, 1)
  /// Holidays and weekly offs inside the leave are counted (EL, HPL…); not for CL.
  countsOffDays    Boolean         @default(true)
  halfDayAllowed   Boolean         @default(false)
  needsCertificate Boolean         @default(false)
  /// Only on a day in the restricted-holiday list.
  restrictedOnly   Boolean         @default(false)
  /// "F" or "M" when the leave is for one gender only.
  gender           String?
  employeeTypes    EmployeeType[]
  /// The reporting officer may sanction up to this many days; beyond that (or when null) an Admin decides.
  officerLimitDays Int?
  sortOrder        Int             @default(0)
  isActive         Boolean         @default(true)
  version          Int             @default(1)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([tenantId, code])
}

enum LeaveEntryKind {
  OPENING
  CREDIT
  DEBIT
  LAPSE
  REVERSAL
}

/// Leave account (LV-07): every credit and debit; the balance is the sum.
model LeaveLedger {
  id            String         @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId    String
  leaveCode     String
  date          DateTime       @db.Date
  kind          LeaveEntryKind
  days          Decimal        @db.Decimal(6, 1)
  /// Credit or lapse period ("2026-H2", "2026", "lapse-2025"); one per person, leave and period.
  period        String?
  applicationId String?
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveCode, period])
  @@index([employeeId, leaveCode])
  @@index([tenantId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
}

model LeaveApplication {
  id               String      @id @default(cuid())
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text, true)"))
  employeeId       String
  leaveCode        String
  fromDate         DateTime    @db.Date
  toDate           DateTime    @db.Date
  halfDay          Boolean     @default(false)
  /// Days of leave counted under the type's rules.
  days             Decimal     @db.Decimal(6, 1)
  /// The balance it is taken from, and how many days (commuted: HPL × 2).
  debitCode        String
  debitDays        Decimal     @db.Decimal(6, 1)
  reason           String
  contact          String?
  attachmentFileId String?
  attachmentName   String?
  attachmentSha256 String?
  status           LeaveStatus @default(PENDING)
  taskId           String?
  /// Entered by HR for someone who does not use the system (LV-05), with the paper sanction.
  onBehalf         Boolean     @default(false)
  sanctionRef      String?
  createdById      String
  decidedAt        DateTime?
  cancelledAt      DateTime?
  cancelNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, fromDate])
  @@index([tenantId, status])
}
