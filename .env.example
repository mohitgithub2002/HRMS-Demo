# Copy to .env and fill in. Generate keys with:  openssl rand -base64 32
# The application's database login. It must NOT be a superuser and must NOT have BYPASSRLS: row-level security is
# one of the walls between organisations (docs/ARCHITECTURE.md).
DATABASE_URL="postgresql://kosh:kosh@localhost:5432/kosh_dev"
# Only when DATABASE_URL goes through a pooler: the direct address, used by migrations and the seed.
# DIRECT_DATABASE_URL=""
# Integration tests (a separate, throw-away database).
TEST_DATABASE_URL="postgresql://kosh:kosh@localhost:5432/kosh_test"
# development | test | training | production
APP_ENV="development"
APP_URL="http://localhost:3000"
# Master keys (32 bytes, base64). Each organisation's keys are derived from these and its id (HKDF).
DATA_ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""
OTP_PEPPER=""
# console = OTPs printed to the server log and shown on screen (never in production); http = real gateway.
SMS_PROVIDER="console"
# disk | database — where uploaded and generated files are kept.
STORAGE_DRIVER="disk"
STORAGE_DIR="./storage"
# The first platform owner, created by the seed (change the password at first sign-in).
PLATFORM_OWNER_EMAIL="owner@kosh.local"
PLATFORM_OWNER_PASSWORD="Kosh@2026"
TRUSTED_PROXY_HOPS="1"
# Only for writing migrations: an empty throw-away database.
SHADOW_DATABASE_URL="postgresql://kosh:kosh@localhost:5432/kosh_shadow"
